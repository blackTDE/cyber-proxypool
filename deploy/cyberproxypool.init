#!/bin/sh /etc/rc.common
# CyberProxyPool OpenWrt / iStoreOS Procd Service Script

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/cyberproxypool
DATA_DIR=/etc/cyberproxypool
HOST=0.0.0.0
PORT=8088
TUNNEL_PORT=10808
BASE_PORT=20001

start_service() {
    [ -d "$DATA_DIR" ] || mkdir -p "$DATA_DIR"
    procd_open_instance cyberproxypool
    procd_set_param command "$PROG" \
        -host "$HOST" \
        -port "$PORT" \
        -tunnel-port "$TUNNEL_PORT" \
        -base-port "$BASE_PORT" \
        -data-dir "$DATA_DIR"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    procd_kill cyberproxypool
}
